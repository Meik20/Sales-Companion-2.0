rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function authUid() {
      return request.auth.uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        currentUserDoc().role == 'admin'
      );
    }

    function currentUserDoc() {
      let userDoc = get(/databases/$(database)/documents/users/$(authUid())).data;
      return userDoc != null ? userDoc : {};
    }

    function isManager() {
      return isSignedIn()
        && currentUserDoc().role == 'manager'
        && currentUserDoc().active == true
        && currentUserDoc().get('emailVerificationPending', false) != true
        && currentUserDoc().get('plan', 'free') != 'free'
        && currentUserDoc().get('subscriptionExpired', false) != true;
    }

    function isOwner(userId) {
      return isSignedIn() && authUid() == userId;
    }

    function isManagedUser(resourceManagerUid) {
      return isManager() && resourceManagerUid == authUid();
    }

    match /users/{uid} {
      allow read: if isAdmin()
        || isOwner(uid)
        || (isManager() && resource.data.managerUid == authUid());

      allow create: if isAdmin() || (
        isOwner(uid)
        // Rôle : ni admin, ni rôle arbitraire
        && request.resource.data.get('role', '') != 'admin'
        && request.resource.data.get('role', '') in ['manager', 'member', 'support_agent', 'independent', '']
        // FIX P0: orgRole NE DOIT PAS être écrit à la création par le client.
        // Ce champ est exclusivement attribué par l'Admin SDK post-inscription (via /api/team/org).
        // Sans cette protection, un utilisateur peut se déclarer 'senior_manager' à l'inscription.
        && !(request.resource.data.keys().hasAny(['orgRole']))
        // Activation : JAMAIS active/activated = true à la création (géré par API)
        && request.resource.data.get('active', false) == false
        && request.resource.data.get('activated', false) == false
        && request.resource.data.get('emailVerificationPending', false) in [true, false]
        // Quotas et plan protégés
        && request.resource.data.get('plan', 'free') == 'free'
        && request.resource.data.get('dailyLimit', 10) <= 10
        && request.resource.data.get('country', 'CM') in ['CM', 'SN', 'CI', 'BJ', 'TG', 'TD', 'CF']
        // ── Protection cross-tenant (P0) ─────────────────────────────────────
        && !('linkedManagerUids' in request.resource.data)
        && !('managerUid' in request.resource.data)
        && !('managerEmail' in request.resource.data)
        && !('orgCode' in request.resource.data)
      );

      allow update: if isAdmin()
        || (
          isOwner(uid)
          // ── Champs exclusivement gérés par l'Admin SDK (API serveur) ──────
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny([
              'role',
              'plan',
              'dailyLimit',
              'active',
              'activated',
              'emailVerificationPending',
              'emailVerified',
              'orgRole',
              'orgCode',
              'managerUid',
              'managerEmail',
              'linkedManagerUids',
              'country',
              'subscriptionExpired',
              'subscriptionExpiresAt',
              'planExpiresAt',
              'paymentPending'
            ])
          // Membres d'équipe : profil complètement verrouillé (géré par le manager)
          && resource.data.get('role', '') != 'member'
          // Managers : ne peuvent pas modifier les champs d'entreprise directement
          && (
            resource.data.get('role', '') != 'manager'
            || !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['company', 'companyName', 'sector', 'region', 'industry'])
          )
        );

      allow delete: if isAdmin();
    }

    match /companies/{companyId} {
      // Lecture : utilisateur authentifié uniquement (pas d'accès public)
      allow read: if isSignedIn();
      // Écriture : Admin SDK uniquement
      allow write: if isAdmin();
    }

    // ── Prospects importés ────────────────────────────────────────────────
    // Toutes les écritures passent par l'API /api/imports (Admin SDK)
    match /manager_prospects/{prospectId} {
      // Lecture : le manager propriétaire ou un agent lié
      allow read: if isAdmin()
        || (isManager() && resource.data.managerId == authUid())
        || (isSupportAgent() && (
              resource.data.managerId == currentUserDoc().managerUid
              || (currentUserDoc().linkedManagerUids != null
                  && resource.data.managerId in currentUserDoc().linkedManagerUids)
           ));
      // Aucune écriture directe côté client — Admin SDK uniquement
      allow create, update, delete: if false;
    }

    function isSupportAgent() {
      return isSignedIn() && (
        request.auth.token.role == 'support_agent' ||
        currentUserDoc().role == 'support_agent'
      );
    }

    match /pipeline/{pipelineId} {
      allow read: if isAdmin()
        || (isSignedIn() && (resource.data.userId == authUid() || resource.data.assignedTo == authUid()))
        || isManagedUser(resource.data.managerUid)

        || (isSupportAgent() 
            && (resource.data.status == 'conclue' || resource.data.status == 'conclusion')
            && (resource.data.managerUid == currentUserDoc().managerUid 
                || (currentUserDoc().linkedManagerUids != null && resource.data.managerUid in currentUserDoc().linkedManagerUids))
           );

      allow create: if isSignedIn()
        && request.resource.data.userId == authUid()
        // FIX: les support agents ne peuvent pas créer de fiches pipeline
        && !isSupportAgent()
        && (
          request.resource.data.managerUid == authUid()
          || request.resource.data.managerUid == currentUserDoc().managerUid
          || request.resource.data.managerUid == null
        );

      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.userId == authUid()
          // FIX: les support agents ne peuvent pas modifier les fiches pipeline
          && !isSupportAgent()
          // Invariants d'appartenance — jamais modifiables par le propriétaire
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny([
                'userId',
                'managerUid',
                'assignedTo',
                'memberAccessId',
                'sourceProspectId',
                'assignedBy',
                'importedBy'
              ])
        )
        || (
          isManagedUser(resource.data.managerUid)
          // Le manager peut réassigner mais ne peut pas changer le propriétaire
          && request.resource.data.userId == resource.data.userId
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['managerUid', 'sourceProspectId', 'importedBy'])
        );
        
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == authUid() && !isSupportAgent())
        || isManagedUser(resource.data.managerUid);
    }

    match /saved_searches/{savedSearchId} {
      allow read: if isSignedIn() && resource.data.userId == authUid();
      allow create: if isSignedIn() && request.resource.data.userId == authUid();
      allow update: if isSignedIn() && resource.data.userId == authUid() && request.resource.data.userId == authUid();
      allow delete: if isSignedIn() && resource.data.userId == authUid();
    }

    match /saved_companies/{companyId} {
      allow read: if isSignedIn() && resource.data.userId == authUid();
      allow create: if isSignedIn() && request.resource.data.userId == authUid();
      allow update: if isSignedIn() && resource.data.userId == authUid() && request.resource.data.userId == authUid();
      allow delete: if isSignedIn() && resource.data.userId == authUid();
    }


    match /support_threads/{threadId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == authUid());
      allow create: if isSignedIn() && request.resource.data.userId == authUid();
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == authUid() && request.resource.data.userId == authUid());
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == authUid());

      match /messages/{messageId} {
        allow read: if isAdmin() || (
          isSignedIn() &&
          get(/databases/$(database)/documents/support_threads/$(threadId)).data.userId == authUid()
        );

        allow create: if isAdmin() || (
          isSignedIn() &&
          get(/databases/$(database)/documents/support_threads/$(threadId)).data.userId == authUid() &&
          request.resource.data.senderId == authUid() &&
          request.resource.data.senderRole == 'user'
        );

        allow update: if false;

        allow delete: if isAdmin() || (
          isSignedIn() &&
          get(/databases/$(database)/documents/support_threads/$(threadId)).data.userId == authUid() &&
          resource.data.senderId == authUid()
        );
      }
    }

    match /team_accesses/{accessId} {
      // FIX: supprimé allow get:false qui créait un conflit logique avec allow read.
      // En Firestore, 'read' couvre à la fois 'get' (lecture d'un doc) et 'list' (requêtes).
      // Mettre get:false alors que read est autorisé est incohérent — read a priorité.
      // Accès uniquement via API Admin SDK ; la lecture directe client est très limitée.
      allow read: if isAdmin()
        || (isManager() && resource.data.managerUid == authUid());

      allow create: if isAdmin()
        || (
          isManager()
          && request.resource.data.managerUid == authUid()
          && (request.resource.data.role == 'member' || request.resource.data.role == 'support_agent')
        );

      allow update: if isAdmin()
        || (isManager() && resource.data.managerUid == authUid());

      allow delete: if isAdmin();
    }

    match /team_assignments/{assignmentId} {
      allow read: if isAdmin()
        || (isManager() && resource.data.managerUid == authUid());

      allow create: if isAdmin()
        || (
          isManager()
          && request.resource.data.managerUid == authUid()
        );

      allow update: if isAdmin()
        || (isManager() && resource.data.managerUid == authUid());

      allow delete: if isAdmin()
        || (isManager() && resource.data.managerUid == authUid());
    }

    match /assignments/{assignmentId} {
      allow read: if isAdmin()
        || (isManager() && resource.data.managerUid == authUid())
        || (isSignedIn() && resource.data.assigneeUid == authUid());

      allow create: if isAdmin()
        || (
          isManager()
          && request.resource.data.managerUid == authUid()
        );

      allow update: if isAdmin()
        || (
          isManager()
          && resource.data.managerUid == authUid()
        )
        || (
          isSignedIn()
          && resource.data.assigneeUid == authUid()
        );

      allow delete: if isAdmin()
        || (isManager() && resource.data.managerUid == authUid());
    }

    match /app_config/{key} {
      allow read, write: if isAdmin();
    }

    match /usage_logs/{logId} {
      allow create: if isSignedIn() && request.resource.data.userId == authUid();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /import_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /adminNotifications/{notificationId} {
      allow read, write: if isAdmin();
    }

    // ── CRM Collections ─────────────────────────────────────────────────────

    match /customer_calls/{callId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.agentUid == authUid())
        || (isManager() && resource.data.managerUid == authUid())
        || (isSupportAgent() && (
             resource.data.managerUid == currentUserDoc().managerUid
             || (currentUserDoc().linkedManagerUids != null && resource.data.managerUid in currentUserDoc().linkedManagerUids)
           ));
      allow create: if isSignedIn()
        && (
          isAdmin()
          || (isManager() && request.resource.data.managerUid == authUid())
          || (isSupportAgent() && (
               request.resource.data.managerUid == currentUserDoc().managerUid
               || (currentUserDoc().linkedManagerUids != null && request.resource.data.managerUid in currentUserDoc().linkedManagerUids)
             ))
        )
        && request.resource.data.agentUid == authUid();
      allow update, delete: if isAdmin()
        || (isSignedIn() && resource.data.agentUid == authUid());
    }

    match /customer_tickets/{ticketId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.agentUid == authUid())
        || (isManager() && resource.data.managerUid == authUid())
        || (isSupportAgent() && (
             resource.data.managerUid == currentUserDoc().managerUid
             || (currentUserDoc().linkedManagerUids != null && resource.data.managerUid in currentUserDoc().linkedManagerUids)
           ));
      allow create: if isSignedIn()
        && (
          isAdmin()
          || (isManager() && request.resource.data.managerUid == authUid())
          || (isSupportAgent() && (
               request.resource.data.managerUid == currentUserDoc().managerUid
               || (currentUserDoc().linkedManagerUids != null && request.resource.data.managerUid in currentUserDoc().linkedManagerUids)
             ))
        )
        && request.resource.data.agentUid == authUid();
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.agentUid == authUid())
        || (isManager() && resource.data.managerUid == authUid());
      allow delete: if isAdmin();
    }

    match /support_agent_links/{linkId} {
      allow read: if isAdmin()
        || (isManager() && resource.data.managerUid == authUid())
        || (isSupportAgent() && resource.data.agentUid == authUid());
      allow create: if isManager()
        && request.resource.data.managerUid == authUid()
        && request.resource.data.status == 'active';
      allow update: if isAdmin()
        || (isManager() && resource.data.managerUid == authUid());
      allow delete: if isAdmin()
        || (isManager() && resource.data.managerUid == authUid());
    }

    // ── Organisations ────────────────────────────────────────────────────────
    // Collection dédiée au référentiel d'organisation (source de vérité unique)
    // Écritures exclusivement via Admin SDK (API routes serveur)
    match /organisations/{orgCode} {
      // Lecture : admin, ou tout utilisateur appartenant à cette org
      // FIX: restreint aux membres de cette org uniquement (isSignedIn() seul était trop large)
      allow read: if isAdmin()
        || (isSignedIn() && currentUserDoc().orgCode == orgCode);

      // Le Senior Manager peut mettre à jour certains champs de son org
      // FIX: ajout de isManager() (abonnement actif requis pour écrire en production)
      allow update: if isAdmin()
        || (
          isManager()
          && currentUserDoc().orgCode == orgCode
          && currentUserDoc().orgRole == 'senior_manager'
          // Champs immuables — protégés même du Senior Manager
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['orgCode', 'createdAt', 'seniorManagerUid'])
        );

      // Création et suppression : Admin SDK uniquement
      allow create, delete: if false;
    }

    // ── Subscription logs ────────────────────────────────────────────────────
    match /subscription_logs/{logId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == authUid());
      allow create: if false; // Admin SDK uniquement
      allow update, delete: if false;
    }

    // ── Paiements ─────────────────────────────────────────────────────────────
    // Toutes les écritures passent par Admin SDK (routes API serveur)
    match /payments/{paymentId} {
      // Un utilisateur peut lire ses propres transactions
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == authUid());
      // Aucune écriture client directe — sécurité maximale
      allow create, update, delete: if false;
    }

    // ── Webhook logs ──────────────────────────────────────────────────────────
    // Logs d'audit des webhooks entrants — lecture admin uniquement
    match /webhook_logs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ── Conversations IA (Historique persistant) ──────────────────────────────
    match /ai_conversations/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();

      match /messages/{messageId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
  }
}