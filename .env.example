# ==============================================================================
# Sales Companion 2.0 - Environment Variables Template
# ==============================================================================
# Copy this file to .env.local (frontend) or .env (backend/root) and fill in the values.
# NEVER commit your actual .env or .env.local files containing real credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 🌐 Application URLs & Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=https://salescompanion2-0.com
NEXT_PUBLIC_API_URL=https://salescompanion2-0.com/api
WEB_ORIGIN=https://salescompanion2-0.com
CORS_ORIGIN=https://salescompanion2-0.com

# ------------------------------------------------------------------------------
# 🔥 Firebase Client (Public - safe in browser bundle)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:000000000000

# ------------------------------------------------------------------------------
# 🏢 Supabase (annuaire Entreprises — clé service côté serveur uniquement)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# 🔒 Firebase Admin SDK (Server-side ONLY)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
# Private key: retain \n or use quoted string with real newlines
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
# Alternative: Path to JSON service account or base64 string
FIREBASE_SERVICE_ACCOUNT_KEY=

# ------------------------------------------------------------------------------
# 💳 CamPay Payments (Mobile Money / MTN / Orange Cameroon)
# ------------------------------------------------------------------------------
CAMPAY_BASE_URL=https://www.campay.net/api
CAMPAY_APP_USERNAME=your_campay_app_username
CAMPAY_APP_PASSWORD=your_campay_app_password
CAMPAY_PERMANENT_TOKEN=your_campay_permanent_token
# CRITICAL: HMAC Webhook Secret configured in CamPay Dashboard > Webhook Settings
# Used to verify incoming webhook signatures (X-Campay-Signature / Authorization)
CAMPAY_WEBHOOK_SECRET=your_campay_webhook_secret_here

# ------------------------------------------------------------------------------
# ⚡ Upstash Redis (Rate Limiting & Company Search Caching)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# ------------------------------------------------------------------------------
# 🤖 AI Assistant (Gemini & Groq)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# ------------------------------------------------------------------------------
# ✉️ Email Providers (Brevo / Sendinblue / SendGrid)
# ------------------------------------------------------------------------------
BREVO_API_KEY=your_brevo_api_key
# Alternative legacy alias
SENDINBLUE_API_KEY=
SENDGRID_API_KEY=

# ------------------------------------------------------------------------------
# 🗺️ External Services & Analytics
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_MAPS_API_KEY=your_google_maps_server_api_key
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# ------------------------------------------------------------------------------
# ⏱️ Cron & Scheduled Tasks (Daily subscription checks)
# ------------------------------------------------------------------------------
# Secret token for protecting GET/POST /api/cron/check-subscriptions
# Vercel Crons automatically sends this in the Authorization: Bearer header
CRON_SECRET=your_cron_secret_token_here
