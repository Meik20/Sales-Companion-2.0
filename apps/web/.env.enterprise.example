# =============================================================================
# SALES COMPANION 2.0 — Mode Instance Entreprise Dédiée
# =============================================================================
# Copiez ce fichier en `.env.local` (ou `.env.production`) dans le projet dédié.
# Le mode "enterprise" verrouille l'accès à votre organisation uniquement.
# La version SaaS publique reste inchangée (ne pas modifier ses variables).
# =============================================================================

# --- Mode de déploiement ---
# "public"     → SaaS public (défaut, ne rien mettre)
# "enterprise" → Instance dédiée entreprise
NEXT_PUBLIC_DEPLOYMENT_MODE=enterprise

# --- Identité de l'entreprise ---
# Nom affiché dans le bandeau de connexion et l'en-tête de l'application
NEXT_PUBLIC_ENTERPRISE_NAME=Groupe SABC

# URL du logo de l'entreprise (optionnel — 300×100 px recommandé, PNG/SVG)
NEXT_PUBLIC_ENTERPRISE_LOGO_URL=https://cdn.groupe-sabc.cm/logo.png

# --- Restriction d'accès par domaine e-mail (optionnel) ---
# Seuls les e-mails dont le domaine figure dans cette liste pourront s'inscrire/se connecter.
# Séparez les domaines par des virgules (sans espaces).
# Laissez vide pour autoriser tous les domaines.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=groupe-sabc.cm,sabc.com

# --- Code organisation dédié (optionnel) ---
# Pré-remplit le champ "Code organisation" lors de l'inscription des Team Managers.
# Doit correspondre à l'orgCode de votre organisation dans Firestore.
NEXT_PUBLIC_DEDICATED_ORG_CODE=SC-CM-SABC1

# =============================================================================
# Credentials Firebase — Projet dédié à l'entreprise
# =============================================================================
# Remplacez ces valeurs par celles de votre projet Firebase d'entreprise.
# Ne JAMAIS réutiliser les credentials du projet SaaS public.
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=votre-projet
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=votre-projet.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# =============================================================================
# Credentials Supabase — Projet dédié à l'entreprise
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =============================================================================
# URL publique de l'instance dédiée
# =============================================================================
NEXT_PUBLIC_APP_URL=https://crm.votre-entreprise.com
